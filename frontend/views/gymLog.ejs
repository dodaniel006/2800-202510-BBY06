<div class="page-wrapper">
  <main>
    <div class="container mt-5">
      Hello there! This is the gym log page.
      <p>
        Here you can track your workouts, set goals, and monitor your progress.
      </p>

      <div id="userInfoForm">
          <input type="text" id="userName" placeholder="Enter your name" class="input" required>
          <input type="number" id="userAge" placeholder="Enter your age" class="input" required>
          <input type="text" id="place" placeholder="Enter your Gym's Location" class="input" required>
          <button id="submitUserInfo" type="submit" class="button">Submit</button>
      </div>

      <div id="location"></div>
      <div id="setLocation"></div>
      <button id="resetView" class="button">Reset View</button>
      <button id="updateLocation" class="button">Update Location</button>
    </div>

    <div class="container">
      <div id="map"></div>
    </div>
  </main>
</div>
