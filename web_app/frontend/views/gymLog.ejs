<div class="page-wrapper">
  <main>
    <div class="container mt-5">
      <h1 class="text-center">Hello there! This is the gym log page.</h1>
      <p class="text-center">
        Here you can track your workouts, set goals, and monitor your progress.
      </p>

      <div id="userInfoForm" class="card p-3 shadow-sm">
        <div class="mb-3">
          <label for="gymName" class="form-label">Gym Name</label>
          <input type="text" id="gymName" placeholder="Enter the Gym's Name" class="form-control" required>
        </div>
        <div class="mb-3">
          <label for="place" class="form-label">Gym Location</label>
          <input type="text" id="place" placeholder="Enter your Gym's Location" class="form-control" required>
        </div>
        <button id="submitUserInfo" type="submit" class="btn btn-primary w-100">Submit</button>
      </div>

      <div id="userLocation" class="mt-4"></div>
      <div id="gymLocation" class="mt-4"></div>
      <div id="checkDistance" class="mt-4"></div>
      <div class="d-flex justify-content-between mt-3">
        <button id="resetView" class="btn btn-secondary">Reset View</button>
        <button id="updateLocation" class="btn btn-success">Update Location</button>
      </div>
    </div>

    <div class="container mt-5">
      <div id="map" class="border rounded mb-5"></div>
    </div>
  </main>
</div>