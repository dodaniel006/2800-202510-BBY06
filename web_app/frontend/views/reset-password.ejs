<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Password</title>
  <!-- Assuming you have a base.css or similar for styling -->
  <link rel="stylesheet" href="/css/base.css">
  <link rel="stylesheet" href="/css/login.css"> <!-- Can reuse login styles or create a new one -->
</head>
<body>
  <section class="vh-100 bb-bg-surface-tr">
    <div class="container py-5 h-100">
      <div class="row d-flex justify-content-center align-items-center h-100">
        <div class="col col-xl-10">
          <div class="card" style="border-radius: 1rem;">
            <div class="row g-0">
              <div class="col-md-6 col-lg-5 d-none d-md-block" style="margin: -1pt;">
                <img src="/images/login_banner.jpg"
                  class="img-fluid w-100 h-100 object-fit-cover rounded-start"
                  alt="login form" style="border-radius: 1rem 0 0 1rem;" />
              </div>
              <div class="col-md-6 col-lg-7 d-flex align-items-center">
                <div class="card-body p-4 p-lg-5 text-black">
                  <form id="reset-password-form">
                    <div class="d-flex align-items-center m-0">
                      <span class="h1 fw-bold mb-0"><img class="logo" src="/images/logo.png"></span>
                    </div>
                    <h5 class="fw-normal mb-3 pb-3" style="letter-spacing: 1px;">Reset Your Password</h5>
                    <p class="mb-3">Enter your new password below.</p>

                    <input type="hidden" id="tokenId" name="tokenId" value="<%= tokenId %>">
                    <input type="hidden" id="token" name="token" value="<%= token %>">

                    <div data-mdb-input-init class="form-outline mb-4">
                      <label class="form-label" for="newPassword">New Password</label>
                      <input type="password" id="newPassword" name="newPassword" class="form-control form-control-lg" required />
                    </div>

                    <div data-mdb-input-init class="form-outline mb-4">
                      <label class="form-label" for="confirmPassword">Confirm New Password</label>
                      <input type="password" id="confirmPassword" name="confirmPassword" class="form-control form-control-lg" required />
                    </div>

                    <div class="pt-1 mb-4">
                      <button id="updatePasswordButton" data-mdb-button-init data-mdb-ripple-init class="btn btn-dark btn-lg btn-block"
                        type="submit">Update Password</button>
                    </div>

                    <div id="resetPasswordMessage" class="alert d-none" role="alert">
                      <!-- Messages will be displayed here -->
                    </div>

                    <p class="mb-2 pb-lg-2 bb-text-surface">Remembered your password? <a href="/login"
                        class="bb-text-surface">Login here</a></p>
                  </form>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <script src="/js/reset-password.js"></script>
</body>
</html>
