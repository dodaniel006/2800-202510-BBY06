
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>


<main class="container">

    <div class="center">
        <h1 class="mt-4">Account</h1>
    </div>
    <div class="row gutters" >
        <div class="col-xl-3 col-lg-3 col-md-12 col-sm-12 col-12">
            <div class="card h-100">
                <div class="card-body">
                    <div class="account-settings">
                        <div class="user-profile">
                            <div class="user-avatar">
                                <!-- Profile Image -->
                                <img id="profileImage" src="/images/profile.png" alt="profileImage" class="profileImage">
                                <!-- Upload Button -->
                                <label for="imageUpload" id="imageUploadButton" class="btn m-auto mt-3 gbtn btn-secondary">Upload Image</label>
                                <input type="file" id="imageUpload" accept="image/*" style="display: none;">
                              </div>
                                <div class="form-group">
                                    <h5 class="mb-2">Username</h5>

                                    <input type="text"  class="form-control InfoField" id="username">
                                </div>
                        </div>
                        <div class="about">
                            <h5 id="publicAbout" class="mb-2">About</h5>
                            <textarea   class="form-control InfoField" id="bio" rows="5"></textarea>
                        </div>
                    </div>
                </div>
               
            </div>
               
        </div>

        

        <div class="col-xl-9 col-lg-9 col-md-12 col-sm-12 col-12">
            <div class="card h-100">
                <div class="card-body">

                    





                    <div class="row gutters">
    
                                 <div class="form-group mb-3">
                        <label for="healthDatePicker"><strong>Health Data Date</strong></label>
                        <input type="text" id="healthDatePicker" class="form-control my-3" />


<div class="row row-cols-2 row-cols-md-3 gy-4 gx-3 justify-content-center text-center">
                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
                            <i class="fas fa-walking fa-lg text-secondary"></i>
                            <span id="totalSteps">Steps: --</span>
                        </div>
                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
                            <i class="fas fa-heartbeat fa-lg text-danger"></i>
                            <span id="avgHeartRate">Avg HR: -- bpm</span>
                        </div>
                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
                            <i class="fas fa-tachometer-alt fa-lg text-info"></i>
                            <span id="avgSpeed">Avg Speed: -- km/h</span>
                        </div>
                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
                            <i class="fas fa-weight fa-lg text-dark"></i>
                            <span id="latestWeight">Weight: -- kg</span>
                        </div>
                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
                            <i class="fas fa-road fa-lg text-warning"></i>
                            <span id="totalDistance">Distance: -- m</span>
                        </div>

                        <div class="col-sm-6 col-lg-4 d-flex align-items-center gap-2">
  <i class="fas fa-bed fa-lg text-primary"></i>
  <span id="sleepDuration">Total Sleep: --</span>
</div>

                        </div>


                    </div>


                    <div class="row gutters">

                        <div class="col-12">
                          <h6 class="mb-2 mt-4">Health Data</h6>
                          <div class="form-group">
                            <a id="ConnectButton" href="healthConnectInstructions" class="btn gbtn btn-secondary" type="button">Connect Health Companion</a>
                          </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <div class="row gutters">
        <div class="col-12">
            <h6 class="mb-2 mt-4">Personal Details</h6>
        </div>
        
        <div class="col-md-6">
            <div class="form-group">
                <label for="eMail">Email</label>
                <input  type="email" class="form-control InfoField" id="email">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="phone">Phone</label>
                <input  type="text" class="form-control InfoField" id="phoneNumber">
            </div>
        </div>
    </div>

    <div class="row gutters">
        <div class="col-12">
            <h6 class="mb-2 mt-4">Address</h6>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="street">Street</label>
                <input  type="text" class="form-control InfoField" id="street">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="city">City</label>
                <input  type="text" class="form-control InfoField" id="city">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="state">Province</label>
                <input  type="text" class="form-control InfoField" id="province">
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="zip">Postal Code</label>
                <input  type="text" class="form-control InfoField" id="postalCode">
            </div>
        </div>
    </div>

    <div class="row gutters mb-3">
        <div class="col-12 bottom-menu text-right pt-3">
            <button type="button" id="cancel" class="btn gbtn btn-secondary">Cancel</button>
            <button type="button" id="save" class="btn gbtn btn-secondary">Save</button>
        </div>
    </div>
</main>
