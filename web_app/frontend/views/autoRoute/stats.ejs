<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>

  <div class="chart-container">
    <h2>Steps Over Time</h2>
    <div class="chart-canvas">
      <canvas id="fitnessChart" height="100"></canvas>
    </div>
    <button class="button"  onclick="resetZoom('fitnessChart')">Reset Zoom</button>
  </div>
  
  <div class="chart-container">
    <h2>Heart Rate Over Time</h2>
    <div class="chart-canvas">
      <canvas id="heartRateChart" height="100"></canvas>
    </div>

    <button class="button"  onclick="resetZoom('heartRateChart')">Reset Zoom</button>
  </div>
  


  <div class="chart-container">
  <h2>Calories Burned Over Time</h2>
  <div class="chart-canvas">
    <canvas id="caloriesChart" height="100"></canvas>
  </div>
  <button class="button" onclick="resetZoom('caloriesChart')">Reset Zoom</button>
</div>

<div class="chart-container">
  <h2>Exercise Sessions</h2>
  <div class="chart-canvas">
