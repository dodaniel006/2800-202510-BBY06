<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
<style>
    canvas {
      touch-action: pan-y;
    }
    .chart-container {
      margin-bottom: 40px;
    }
    #fitnessChart, #heartRateChart, #sleepChart {
      max-width: 100%;
      background: white;
      border-radius: 8px;
      box-shadow: 0 0 10px rgba(0,0,0,0.1);
      padding: 1rem;
      margin-bottom: 20px;
    }
    button {
      margin-bottom: 40px;
      padding: 6px 12px;
      border-radius: 6px;
      border: none;
      background-color: #eee;
      cursor: pointer;
    }
  </style>
  <div class="chart-container">
    <h2>Steps Over Time</h2>
    <canvas id="fitnessChart" height="100"></canvas>
    <button onclick="resetZoom('fitnessChart')">Reset Zoom</button>
  </div>
  
  <div class="chart-container">
    <h2>Heart Rate Over Time</h2>
    <canvas id="heartRateChart" height="100"></canvas>
    <button onclick="resetZoom('heartRateChart')">Reset Zoom</button>
  </div>
  


  <div class="chart-container">
  <h2>Calories Burned Over Time</h2>
  <canvas id="caloriesChart" height="100"></canvas>
  <button onclick="resetZoom('caloriesChart')">Reset Zoom</button>
</div>

<div class="chart-container">
  <h2>Exercise Sessions</h2>
  <canvas id="exerciseChart" height="100"></canvas>
  <button onclick="resetZoom('exerciseChart')">Reset Zoom</button>
</div>

<div class="chart-container">
  <h2>Speed Over Time</h2>
  <canvas id="speedChart" height="100"></canvas>
  <button onclick="resetZoom('speedChart')">Reset Zoom</button>
</div>

<div class="chart-container">
  <h2>Weight Over Time</h2>
  <canvas id="weightChart" height="100"></canvas>
  <button onclick="resetZoom('weightChart')">Reset Zoom</button>
</div>


<div class="chart-container">
  <h2>Distance Over Time</h2>
  <canvas id="distanceChart" height="100"></canvas>
  <button onclick="resetZoom('distanceChart')">Reset Zoom</button>
</div>

<div class="chart-container">
  <h2>Speed vs. Heart Rate</h2>
  <canvas id="correlationChart" height="100"></canvas>
  <button onclick="resetZoom('correlationChart')">Reset Zoom</button>
</div>

<div class="chart-container" style="max-width: 400px; margin: auto;">
  <h2>Sleep Clock (24-Hour Radial)</h2>
  <canvas id="sleepClock" width="300" height="300"></canvas>
</div>
